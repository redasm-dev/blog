---
import { Icon } from "astro-icon/components";
import Main from "../layouts/Main.astro";
import Post from "../components/Post.astro";
import { MAX_RECENTS, SITE_TAGLINE } from "../consts.ts";
import { getSortedPosts } from "../utils.js";

const posts = await getSortedPosts();
const recentPosts = posts.slice(0, MAX_RECENTS);
---

<Main>
    <section class="pt-10 pb-4">
        <h1 class="text-5xl font-bold">
            <span class="text-branding">RE</span>Dasm Dev Blog
        </h1>
        <p class="mt-3 text-muted-text">{SITE_TAGLINE}</p>
        <div class="mt-6 h-1 w-16 bg-primary"></div>
    </section>
    {
        recentPosts.length > 0 && (
        <section>
            <ul>
                {recentPosts.map(x => <Post post={x}/>)}
            </ul>

            <div class="mt-4 text-center">
                <a href="/posts" class="inline-flex mx-auto flex items-center hover:text-highlight p-1">
                    All Posts
                    <Icon name="mdi:chevron-right" size="2rem"/>
                </a>
            </div>
        </section>
        )
    }
</Main>
