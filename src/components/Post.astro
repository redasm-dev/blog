---
import dayjs from "dayjs";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { getExcerpt } from "../utils.js";

const { post } = Astro.props

const url = `/posts/${post.id}`;
const date = dayjs(post.data.modified || post.data.published).format("DD MMMM YYYY");
const excerpt = await getExcerpt(post); // <!-- more --> in the post, else the description
---

<li class="py-6 flex flex-col md:flex-row gap-6 border-b border-muted/40 last:border-b-0">
    <div class="flex-1">
        <h3 class="text-2xl pb-2 font-bold">
            <a class="hover:border-b" href={url}>{post.data.title}</a>
        </h3>
        <div class="text-muted-text flex items-center gap-x-2">
            <Icon name="mdi:newspaper-variant-outline"/>
            {date}
            {post.data.modified && "(Updated)"}
        </div>
        { excerpt ? <div class="post-excerpt mt-2" set:html={excerpt}/> : <p>{post.data.description}</p> }
            <a href={url} aria-label={`Continue reading: ${post.data.title}`}
               class="inline-flex items-center gap-x-2 mt-4 px-3 py-1 border border-primary
                      text-sm uppercase tracking-[0.08em] hover:bg-primary">
                Continue reading <Icon name="mdi:chevron-right" size="1.2rem"/>
            </a>
    </div>
    {
        post.data.image && (
        <a href={url} class="md:w-1/3 shrink-0" tabindex="-1">
            <Image src={post.data.image} alt="" class="rounded w-full h-auto"/>
        </a>
        )
    }
</li>
